// From-scratch GLM numerical kernels. C ABI: kernels.h.
// Storage and arithmetic are f32; no allocation, tensors, or framework calls.
extern "C" {
  fn expf(x: f32) -> f32;
  fn sqrtf(x: f32) -> f32;
}

fn glm_vx_sigmoid_scalar(x: f32) -> f32 {
  let mut result: f32 = 0.0;
  unsafe {
    if x >= 0.0 { result = 1.0 / (1.0 + expf(0.0 - x)); }
    else { let z: f32 = expf(x); result = z / (1.0 + z); }
  }
  return result;
}

fn glm_vx_rmsnorm(out: *mut f32, x: *const f32, weight: *const f32, n: i32, eps: f32) -> i32 {
  if n <= 0 { return -1; }
  if eps <= 0.0 { return -1; }
  unsafe {
    let mut ss: f32 = 0.0;
    for i in 0..n { ss = ss + x[i] * x[i]; }
    let inv: f32 = 1.0 / sqrtf(ss / (n as f32) + eps);
    for i in 0..n { out[i] = x[i] * inv * weight[i]; }
  }
  return 0;
}

fn glm_vx_layernorm(out: *mut f32, x: *const f32, weight: *const f32, bias: *const f32, n: i32, eps: f32) -> i32 {
  if n <= 0 { return -1; }
  if eps <= 0.0 { return -1; }
  unsafe {
    let mut mean: f32 = 0.0;
    for i in 0..n { mean = mean + x[i]; }
    mean = mean / (n as f32);
    let mut variance: f32 = 0.0;
    for i in 0..n { let d: f32 = x[i] - mean; variance = variance + d * d; }
    let inv: f32 = 1.0 / sqrtf(variance / (n as f32) + eps);
    for i in 0..n { out[i] = (x[i] - mean) * inv * weight[i] + bias[i]; }
  }
  return 0;
}

fn glm_vx_softmax(out: *mut f32, x: *const f32, n: i32) -> i32 {
  if n <= 0 { return -1; }
  unsafe {
    let mut maximum: f32 = x[0];
    for i in 1..n { if x[i] > maximum { maximum = x[i]; } }
    let mut sum: f32 = 0.0;
    for i in 0..n { let v: f32 = expf(x[i] - maximum); out[i] = v; sum = sum + v; }
    for i in 0..n { out[i] = out[i] / sum; }
  }
  return 0;
}

fn glm_vx_swiglu(out: *mut f32, gate: *const f32, up: *const f32, n: i32) -> i32 {
  if n < 0 { return -1; }
  unsafe { for i in 0..n { out[i] = gate[i] * glm_vx_sigmoid_scalar(gate[i]) * up[i]; } }
  return 0;
}

fn glm_vx_add(out: *mut f32, a: *const f32, b: *const f32, n: i32) -> i32 {
  if n < 0 { return -1; }
  unsafe { for i in 0..n { out[i] = a[i] + b[i]; } }
  return 0;
}

fn glm_vx_axpy(out: *mut f32, x: *const f32, alpha: f32, n: i32) -> i32 {
  if n < 0 { return -1; }
  unsafe { for i in 0..n { out[i] = out[i] + alpha * x[i]; } }
  return 0;
}

// Independent output rows become SIMD lanes at O3 without reassociating
// a dot product. Output must not overlap either input (as in VxBackend).
fn glm_vx_matvec(out: *mut f32, weight: *const f32, x: *const f32, rows: i32, cols: i32) -> i32 {
  if rows < 0 { return -1; }
  if cols < 0 { return -1; }
  unsafe {
    for block in 0..(rows / 8) {
      let r: i32 = block * 8;
      let mut s0: f32 = 0.0;
      let mut s1: f32 = 0.0;
      let mut s2: f32 = 0.0;
      let mut s3: f32 = 0.0;
      let mut s4: f32 = 0.0;
      let mut s5: f32 = 0.0;
      let mut s6: f32 = 0.0;
      let mut s7: f32 = 0.0;
      for c in 0..cols {
        let v: f32 = x[c];
        s0 = s0 + weight[(r + 0) * cols + c] * v;
        s1 = s1 + weight[(r + 1) * cols + c] * v;
        s2 = s2 + weight[(r + 2) * cols + c] * v;
        s3 = s3 + weight[(r + 3) * cols + c] * v;
        s4 = s4 + weight[(r + 4) * cols + c] * v;
        s5 = s5 + weight[(r + 5) * cols + c] * v;
        s6 = s6 + weight[(r + 6) * cols + c] * v;
        s7 = s7 + weight[(r + 7) * cols + c] * v;
      }
      out[r + 0] = s0;
      out[r + 1] = s1;
      out[r + 2] = s2;
      out[r + 3] = s3;
      out[r + 4] = s4;
      out[r + 5] = s5;
      out[r + 6] = s6;
      out[r + 7] = s7;
    }
    let mut tail: i32 = (rows / 8) * 8;
    for pair in 0..((rows - tail) / 2) {
      let r: i32 = tail + pair * 2;
      let mut s0: f32 = 0.0;
      let mut s1: f32 = 0.0;
      for c in 0..cols {
        let v: f32 = x[c];
        s0 = s0 + weight[r * cols + c] * v;
        s1 = s1 + weight[(r + 1) * cols + c] * v;
      }
      out[r] = s0;
      out[r + 1] = s1;
    }
    tail = tail + ((rows - tail) / 2) * 2;
    for r in tail..rows {
      let mut sum: f32 = 0.0;
      for c in 0..cols { sum = sum + weight[r * cols + c] * x[c]; }
      out[r] = sum;
    }
  }
  return 0;
}

// C = A[M,K] @ B[N,K]^T. Eight independent row accumulators reuse each
// weight load without reassociating any dot-product reduction.
fn glm_vx_matmul_nt(out: *mut f32, a: *const f32, b: *const f32, m: i32, n: i32, k: i32) -> i32 {
  if m < 0 { return -1; }
  if n < 0 { return -1; }
  if k < 0 { return -1; }
  unsafe {
    for block in 0..(m / 8) {
      let base: i32 = block * 8;
      for c in 0..n {
        let mut s0: f32 = 0.0;
        let mut s1: f32 = 0.0;
        let mut s2: f32 = 0.0;
        let mut s3: f32 = 0.0;
        let mut s4: f32 = 0.0;
        let mut s5: f32 = 0.0;
        let mut s6: f32 = 0.0;
        let mut s7: f32 = 0.0;
        for j in 0..k {
          let w: f32 = b[c * k + j];
          s0 = s0 + a[(base + 0) * k + j] * w;
          s1 = s1 + a[(base + 1) * k + j] * w;
          s2 = s2 + a[(base + 2) * k + j] * w;
          s3 = s3 + a[(base + 3) * k + j] * w;
          s4 = s4 + a[(base + 4) * k + j] * w;
          s5 = s5 + a[(base + 5) * k + j] * w;
          s6 = s6 + a[(base + 6) * k + j] * w;
          s7 = s7 + a[(base + 7) * k + j] * w;
        }
        out[(base + 0) * n + c] = s0;
        out[(base + 1) * n + c] = s1;
        out[(base + 2) * n + c] = s2;
        out[(base + 3) * n + c] = s3;
        out[(base + 4) * n + c] = s4;
        out[(base + 5) * n + c] = s5;
        out[(base + 6) * n + c] = s6;
        out[(base + 7) * n + c] = s7;
      }
    }
    // Reuse each weight for 4- and 2-row tails without changing any dot's
    // left-to-right f32 accumulation order. At most one row remains scalar.
    let mut tail: i32 = (m / 8) * 8;
    if m - tail >= 4 {
      for c in 0..n {
        let mut s0: f32 = 0.0;
        let mut s1: f32 = 0.0;
        let mut s2: f32 = 0.0;
        let mut s3: f32 = 0.0;
        for j in 0..k {
          let w: f32 = b[c * k + j];
          s0 = s0 + a[tail * k + j] * w;
          s1 = s1 + a[(tail + 1) * k + j] * w;
          s2 = s2 + a[(tail + 2) * k + j] * w;
          s3 = s3 + a[(tail + 3) * k + j] * w;
        }
        out[tail * n + c] = s0;
        out[(tail + 1) * n + c] = s1;
        out[(tail + 2) * n + c] = s2;
        out[(tail + 3) * n + c] = s3;
      }
      tail = tail + 4;
    }
    if m - tail >= 2 {
      for c in 0..n {
        let mut s0: f32 = 0.0;
        let mut s1: f32 = 0.0;
        for j in 0..k {
          let w: f32 = b[c * k + j];
          s0 = s0 + a[tail * k + j] * w;
          s1 = s1 + a[(tail + 1) * k + j] * w;
        }
        out[tail * n + c] = s0;
        out[(tail + 1) * n + c] = s1;
      }
      tail = tail + 2;
    }
    for r in tail..m {
      for c in 0..n {
        let mut sum: f32 = 0.0;
        for j in 0..k { sum = sum + a[r * k + j] * b[c * k + j]; }
        out[r * n + c] = sum;
      }
    }
  }
  return 0;
}

// Rotate adjacent pairs in the LAST rope_dim elements of each head.
// cos/sin hold one coefficient per pair, computed for the caller's position.
fn glm_vx_rope(out: *mut f32, x: *const f32, cosine: *const f32, sine: *const f32, heads: i32, head_dim: i32, rope_dim: i32) -> i32 {
  return glm_vx_rope_offset(out, x, cosine, sine, heads, head_dim, rope_dim, head_dim - rope_dim);
}

fn glm_vx_rope_offset(out: *mut f32, x: *const f32, cosine: *const f32, sine: *const f32, heads: i32, head_dim: i32, rope_dim: i32, offset: i32) -> i32 {
  if heads < 0 { return -1; }
  if rope_dim < 0 { return -1; }
  if offset < 0 { return -1; }
  if head_dim < rope_dim { return -1; }
  if offset > head_dim - rope_dim { return -1; }
  if rope_dim % 2 != 0 { return -1; }
  unsafe {
    for h in 0..heads {
      let base: i32 = h * head_dim;
      for d in 0..offset { out[base + d] = x[base + d]; }
      for d in (offset + rope_dim)..head_dim { out[base + d] = x[base + d]; }
      for p in 0..(rope_dim / 2) {
        let i: i32 = base + offset + p * 2;
        let a: f32 = x[i];
        let b: f32 = x[i + 1];
        out[i] = a * cosine[p] - b * sine[p];
        out[i + 1] = a * sine[p] + b * cosine[p];
      }
    }
  }
  return 0;
}

// Stable ties choose the smaller expert index. Bias affects choice, never weight.
// GLM5.3 n_group=topk_group=1; no grouped restriction is needed for this model.
fn glm_vx_router(indices: *mut i32, weights: *mut f32, logits: *const f32, bias: *const f32, experts: i32, k: i32, scale: f32) -> i32 {
  if k <= 0 { return -1; }
  if experts < k { return -1; }
  unsafe {
    let mut total: f32 = 0.0;
    for slot in 0..k {
      let mut best: i32 = -1;
      let mut best_score: f32 = 0.0;
      for e in 0..experts {
        let mut used: i32 = 0;
        for previous in 0..slot { if indices[previous] == e { used = 1; } }
        if used == 0 {
          let score: f32 = glm_vx_sigmoid_scalar(logits[e]) + bias[e];
          if best < 0 { best = e; best_score = score; }
          else { if score > best_score { best = e; best_score = score; } }
        }
      }
      indices[slot] = best;
      let prob: f32 = glm_vx_sigmoid_scalar(logits[best]);
      weights[slot] = prob;
      total = total + prob;
    }
    // Reference GLM adds 1e-20 to handle underflowed sigmoid.
    total = total + 0.00000000000000000001;
    for slot in 0..k { weights[slot] = weights[slot] / total * scale; }
  }
  return 0;
}

// A worse selection has a smaller score, or a larger index at equal score.
// Scores are finite by the model-facing contract. +/-0 compare as equal.
fn glm_vx_topk_worse(a: i32, b: i32, scores: *const f32) -> bool {
  unsafe {
    if scores[a] < scores[b] { return true; }
    if scores[a] == scores[b] { return a > b; }
  }
  return false;
}

// Restore a worst-first heap in indices[0..size]; no temporary allocations.
fn glm_vx_topk_sift(indices: *mut i32, scores: *const f32, size: i32) -> i32 {
  unsafe {
    let mut parent: i32 = 0;
    // parent < size/2 guarantees 2*parent+1 cannot overflow int32.
    let mut active: bool = true;
    for depth in 0..31 {
      if active && parent < size / 2 {
      let mut child: i32 = parent * 2 + 1;
      if child + 1 < size {
        if glm_vx_topk_worse(indices[child + 1], indices[child], scores) { child = child + 1; }
      }
      if glm_vx_topk_worse(indices[child], indices[parent], scores) {
        let tmp: i32 = indices[parent];
        indices[parent] = indices[child];
        indices[child] = tmp;
        parent = child;
      } else { active = false; }
      }
    }
  }
  return 0;
}

// Exact stable top-k in O(n log(k) + k log(k)), O(k) output workspace.
// Heap root is the worst retained entry. Sorting that heap leaves descending
// scores with smaller positions first at ties, identical to the scalar scan.
fn glm_vx_topk(indices: *mut i32, scores: *const f32, n: i32, k: i32) -> i32 {
  if n < 0 { return -1; }
  if k < 0 { return -1; }
  if n < k { return -1; }
  if k == 0 { return 0; }
  unsafe {
    for i in 0..k {
      indices[i] = i;
      let mut child: i32 = i;
      let mut active: bool = true;
      for depth in 0..31 {
        if active && child > 0 {
        let parent: i32 = (child - 1) / 2;
        if glm_vx_topk_worse(indices[child], indices[parent], scores) {
          let tmp: i32 = indices[parent];
          indices[parent] = indices[child];
          indices[child] = tmp;
          child = parent;
        } else { active = false; }
        }
      }
    }
    for i in k..n {
      if glm_vx_topk_worse(indices[0], i, scores) {
        indices[0] = i;
        glm_vx_topk_sift(indices, scores, k);
      }
    }
    for reverse in 1..k {
      let size: i32 = k - reverse;
      let tmp: i32 = indices[0];
      indices[0] = indices[size];
      indices[size] = tmp;
      glm_vx_topk_sift(indices, scores, size);
    }
  }
  return 0;
}

// One query/head; K[T,D], V[T,DV]. Caller supplies eligible (causal) tokens.
fn glm_vx_attention(out: *mut f32, scratch: *mut f32, q: *const f32, keys: *const f32, values: *const f32, tokens: i32, dim: i32, value_dim: i32, scale: f32) -> i32 {
  if tokens <= 0 { return -1; }
  if dim <= 0 { return -1; }
  if value_dim <= 0 { return -1; }
  unsafe {
    for t in 0..tokens {
      let mut score: f32 = 0.0;
      for d in 0..dim { score = score + q[d] * keys[t * dim + d]; }
      scratch[t] = score * scale;
    }
    glm_vx_softmax(scratch, scratch, tokens);
    for d in 0..value_dim {
      let mut sum: f32 = 0.0;
      for t in 0..tokens { sum = sum + scratch[t] * values[t * value_dim + d]; }
      out[d] = sum;
    }
  }
  return 0;
}

// Same computation restricted to selected token IDs. Checks IDs before writing.
fn glm_vx_sparse_attention(out: *mut f32, scratch: *mut f32, q: *const f32, keys: *const f32, values: *const f32, selected: *const i32, count: i32, tokens: i32, dim: i32, value_dim: i32, scale: f32) -> i32 {
  if count <= 0 { return -1; }
  if tokens <= 0 { return -1; }
  if dim <= 0 { return -1; }
  if value_dim <= 0 { return -1; }
  unsafe {
    for j in 0..count { if selected[j] < 0 { return -1; } if selected[j] >= tokens { return -1; } }
    for j in 0..count {
      let t: i32 = selected[j];
      let mut score: f32 = 0.0;
      for d in 0..dim { score = score + q[d] * keys[t * dim + d]; }
      scratch[j] = score * scale;
    }
    glm_vx_softmax(scratch, scratch, count);
    for d in 0..value_dim {
      let mut sum: f32 = 0.0;
      for j in 0..count { sum = sum + scratch[j] * values[selected[j] * value_dim + d]; }
      out[d] = sum;
    }
  }
  return 0;
}

// DSA one-query token scores. q[heads,dim], keys[tokens,dim].
// weights are already scaled by heads^-0.5, qk_scale = dim^-0.5.
fn glm_vx_index_scores(out: *mut f32, q: *const f32, keys: *const f32, weights: *const f32, tokens: i32, heads: i32, dim: i32, qk_scale: f32) -> i32 {
  if tokens < 0 { return -1; }
  if heads <= 0 { return -1; }
  if dim <= 0 { return -1; }
  unsafe {
    for t in 0..tokens {
      let mut total: f32 = 0.0;
      for h in 0..heads {
        let mut dot: f32 = 0.0;
        for d in 0..dim { dot = dot + q[h * dim + d] * keys[t * dim + d]; }
        let score: f32 = dot * qk_scale;
        if score > 0.0 { total = total + weights[h] * score; }
      }
      out[t] = total;
    }
  }
  return 0;
}

// Official GLM interleaved-input RoPE returns [rotated-even, rotated-odd].
// Unlike glm_vx_rope, out must NOT alias x because output permutes positions.
fn glm_vx_rope_glm(out: *mut f32, x: *const f32, cosine: *const f32, sine: *const f32, heads: i32, dim: i32) -> i32 {
  if heads < 0 { return -1; }
  if dim <= 0 { return -1; }
  if dim % 2 != 0 { return -1; }
  unsafe {
    for h in 0..heads {
      let base: i32 = h * dim;
      for p in 0..(dim / 2) {
        let a: f32 = x[base + 2 * p];
        let b: f32 = x[base + 2 * p + 1];
        out[base + p] = a * cosine[p] - b * sine[p];
        out[base + dim / 2 + p] = b * cosine[p] + a * sine[p];
      }
    }
  }
  return 0;
}
