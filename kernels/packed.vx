        out[(token + 1) * rows + r] = s1;
        out[(token + 2) * rows + r] = s2;
        out[(token + 3) * rows + r] = s3;
        out[(token + 4) * rows + r] = s4;
        out[(token + 5) * rows + r] = s5;
        out[(token + 6) * rows + r] = s6;
        out[(token + 7) * rows + r] = s7;
        out[(token + 8) * rows + r] = s8;
        out[(token + 9) * rows + r] = s9;
        out[(token + 10) * rows + r] = s10;
        out[(token + 11) * rows + r] = s11;
        out[(token + 12) * rows + r] = s12;
        out[(token + 13) * rows + r] = s13;
        out[(token + 14) * rows + r] = s14;
        out[(token + 15) * rows + r] = s15;
      }
      token = token + 16;
    }
    let count8: i32 = (batch - token) / 8;
    for tile_index in 0..count8 {
      for r in 0..rows {
        let mut s0: f32 = 0.0;
        let mut s1: f32 = 0.0;
        let mut s2: f32 = 0.0;
        let mut s3: f32 = 0.0;
        let mut s4: f32 = 0.0;
        let mut s5: f32 = 0.0;
        let mut s6: f32 = 0.0;
        let mut s7: f32 = 0.0;
        for block in 0..blocks {
          let b: i32 = (r * blocks + block) * 136;
          for j in 0..256 {
            let v: f32 = packed_weight_iq4_xs(w, b, j, half, table);
            let p: i32 = token * cols + (block * 256 + j) * 8;
            s0 = s0 + v * x[p + 0];
            s1 = s1 + v * x[p + 1];
            s2 = s2 + v * x[p + 2];
            s3 = s3 + v * x[p + 3];
            s4 = s4 + v * x[p + 4];
            s5 = s5 + v * x[p + 5];
            s6 = s6 + v * x[p + 6];
            s7 = s7 + v * x[p + 7];
          }
        }
        out[(token + 0) * rows + r] = s0;
        out[(token + 1) * rows + r] = s1;
        out[(token + 2) * rows + r] = s2;
        out[(token + 3) * rows + r] = s3;
        out[(token + 4) * rows + r] = s4;
        out[(token + 5) * rows + r] = s5;
        out[(token + 6) * rows + r] = s6;
        out[(token + 7) * rows + r] = s7;
      }
      token = token + 8;
    }
    let count4: i32 = (batch - token) / 4;
    for tile_index in 0..count4 {
      for r in 0..rows {
        let mut s0: f32 = 0.0;
        let mut s1: f32 = 0.0;
        let mut s2: f32 = 0.0;
        let mut s3: f32 = 0.0;
        for block in 0..blocks {
          let b: i32 = (r * blocks + block) * 136;
          for j in 0..256 {
            let v: f32 = packed_weight_iq4_xs(w, b, j, half, table);
            let p: i32 = token * cols + (block * 256 + j) * 4;
            s0 = s0 + v * x[p + 0];
            s1 = s1 + v * x[p + 1];
            s2 = s2 + v * x[p + 2];
            s3 = s3 + v * x[p + 3];
          }
        }
        out[(token + 0) * rows + r] = s0;
        out[(token + 1) * rows + r] = s1;
        out[(token + 2) * rows + r] = s2;
        out[(token + 3) * rows + r] = s3;
      }
      token = token + 4;
    }
    let count2: i32 = (batch - token) / 2;
    for tile_index in 0..count2 {
      for r in 0..rows {
        let mut s0: f32 = 0.0;
        let mut s1: f32 = 0.0;
        for block in 0..blocks {
          let b: i32 = (r * blocks + block) * 136;
          for j in 0..256 {
            let v: f32 = packed_weight_iq4_xs(w, b, j, half, table);
            let p: i32 = token * cols + (block * 256 + j) * 2;
            s0 = s0 + v * x[p + 0];
            s1 = s1 + v * x[p + 1];
          }
        }
        out[(token + 0) * rows + r] = s0;
        out[(token + 1) * rows + r] = s1;
      }
      token = token + 2;
    }
    let count1: i32 = (batch - token) / 1;
    for tile_index in 0..count1 {
      for r in 0..rows {
        let mut s0: f32 = 0.0;
        for block in 0..blocks {
          let b: i32 = (r * blocks + block) * 136;
          for j in 0..256 {
            let v: f32 = packed_weight_iq4_xs(w, b, j, half, table);
            let p: i32 = token * cols + (block * 256 + j) * 1;
            s0 = s0 + v * x[p + 0];
          }
        }
        out[(token + 0) * rows + r] = s0;
      }
      token = token + 1;
    }
  }
  return 0;
}
